<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 e anteriores (Auto Backup): nada da aplicação entra na cópia de segurança.
    O manifesto também tem android:allowBackup="false".
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
